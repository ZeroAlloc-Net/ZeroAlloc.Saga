<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>AotSmokeRedis</RootNamespace>
    <AssemblyName>AotSmokeRedis</AssemblyName>

    <!-- Native AOT publish of ZeroAlloc.Saga.Redis and ZeroAlloc.Saga.Outbox.Redis. CI publishes
         this sample but does not run it, because running needs a Redis server; the publish alone
         runs ILC over every Redis code path Main reaches, and TreatWarningsAsErrors from
         Directory.Build.props makes any trim or AOT warning fail it. Run it locally with
         REDIS_CONNECTION set, e.g. REDIS_CONNECTION=localhost:6379. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Sample relaxations, as in AotSmokeOutbox.
         ZAM003: Mediator's "use readonly record struct" hint; the commands mirror the fixtures. -->
    <NoWarn>$(NoWarn);MA0004;MA0011;MA0048;MA0051;CA1305;CA1812;CA2007;ZAM003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Mediator" />
    <PackageReference Include="ZeroAlloc.Serialisation" />
    <PackageReference Include="ZeroAlloc.Outbox" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga\ZeroAlloc.Saga.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Redis\ZeroAlloc.Saga.Redis.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Outbox\ZeroAlloc.Saga.Outbox.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Outbox.Redis\ZeroAlloc.Saga.Outbox.Redis.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Generator\ZeroAlloc.Saga.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
