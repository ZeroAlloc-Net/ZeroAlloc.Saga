<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>AotSmokeOutbox</RootNamespace>
    <AssemblyName>AotSmokeOutbox</AssemblyName>

    <!-- The whole point of this sample: end-to-end native AOT publish.
         WithOutbox() learns the saga command types from the generated
         GeneratedSagaCommandSource that With{Saga}() registers, and the worker
         dispatches through it into ZeroAlloc.Saga.Generated.SagaCommandRegistry.
         Both are referenced directly, with no reflection, so this proves the
         outbox round trip survives trimming without any rooting attribute.
         -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Sample relaxations.
         ZAM003: Mediator's "use readonly record struct" hint — most commands
                 mirror the saga test fixtures, which use record class. -->
    <NoWarn>$(NoWarn);MA0004;MA0011;MA0048;MA0051;CA1305;CA1812;CA2007;ZAM003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Mediator" />
    <!-- Mediator source generator emits IMediator.Send/Publish overloads for the
         in-project IRequest<T> / INotificationHandler<T> types. -->
    <PackageReference Include="ZeroAlloc.Mediator.Generator" PrivateAssets="all" />
    <PackageReference Include="ZeroAlloc.Serialisation" />
    <PackageReference Include="ZeroAlloc.Outbox" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga\ZeroAlloc.Saga.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Outbox\ZeroAlloc.Saga.Outbox.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Generator\ZeroAlloc.Saga.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
