<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>AotSmokeOrm</RootNamespace>
    <AssemblyName>AotSmokeOrm</AssemblyName>

    <!-- Native AOT publish of ZeroAlloc.Saga.Orm and ZeroAlloc.Saga.Outbox.Orm, run against an
         in-process SQLite file so CI needs no database server. PublishAot is set here, not on the
         command line, for the same reason as AotSmoke: the command-line form reaches the
         netstandard2.0 generator project too. TreatWarningsAsErrors comes from
         Directory.Build.props and also makes every ILC trim or AOT warning fail the publish. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Sample relaxations, as in AotSmokeOutbox.
         ZAM003: Mediator's "use readonly record struct" hint; the commands mirror the fixtures. -->
    <NoWarn>$(NoWarn);MA0004;MA0011;MA0048;MA0051;CA1305;CA1812;CA2007;ZAM003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Mediator" />
    <PackageReference Include="ZeroAlloc.Serialisation" />
    <PackageReference Include="ZeroAlloc.Outbox.Orm" />
    <PackageReference Include="ZeroAlloc.ORM" />
    <PackageReference Include="AdoNet.Async.Adapters" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga\ZeroAlloc.Saga.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Orm\ZeroAlloc.Saga.Orm.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Outbox\ZeroAlloc.Saga.Outbox.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Outbox.Orm\ZeroAlloc.Saga.Outbox.Orm.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Generator\ZeroAlloc.Saga.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
