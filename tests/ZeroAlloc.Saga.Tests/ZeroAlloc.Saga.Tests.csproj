<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      MA0048: test types intentionally grouped; MA0051: test methods may be long.
      ZAM003: Mediator's "use readonly record struct" hint — saga commands are
              record class on purpose (saga state may include reference fields).
    -->
    <NoWarn>$(NoWarn);MA0048;MA0051;ZAM003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Directory.Packages.props keeps ZeroAlloc.Mediator at the 5.1 floor src ships with;
         the tests run against the newest major so a consumer who upgrades Mediator is covered. -->
    <PackageReference Include="ZeroAlloc.Mediator" VersionOverride="6.0.*" />
    <!-- Mediator source generator: emits IMediator.Send/Publish overloads for the
         in-project IRequest<T> / INotificationHandler<T> types (the latter come
         from the Saga generator's emitted handlers). Wired as analyzer asset. -->
    <PackageReference Include="ZeroAlloc.Mediator.Generator" VersionOverride="6.0.*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga\ZeroAlloc.Saga.csproj" />
    <!-- Wire the Saga generator as analyzer so the [Saga] fixture in this project gets emitted. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.Saga.Generator\ZeroAlloc.Saga.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
