<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Allow pinning transitively-resolved package versions (used below to
         override the vulnerable native SQLite binary pulled in by EF Core Sqlite). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime deps -->
    <PackageVersion Include="ZeroAlloc.TestHelpers" Version="1.7.*" />
    <PackageVersion Include="ZeroAlloc.Mediator" Version="5.1.*" />
    <PackageVersion Include="ZeroAlloc.Pipeline" Version="1.4.*" />
    <!-- ZeroAlloc.Saga ships this generator to consumers as a package dependency, #285, so its floor
         is what a project that references only ZeroAlloc.Saga compiles with. 6.6.1 is the first
         version that dispatches every handler interface a class implements, Mediator#334; with
         5.1.x the README quick start fails with ZAM001. The generator's output compiles against
         the ZeroAlloc.Mediator 5.1 runtime floor above, so the runtime floor stays where it is. -->
    <PackageVersion Include="ZeroAlloc.Mediator.Generator" Version="6.6.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />

    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q: EF Core Sqlite pulls
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 (bundles SQLite < 3.50.2). Pin the native
         binary to 3.50.3 (SQLite 3.50.3) via transitive pinning; satisfies both the
         net8.0/EFCore9 and net10.0/EFCore10 graphs. core/provider stay on 2.x
         (the sqlite3 C ABI is stable). Drop once EF Core ships a bumped SQLitePCLRaw. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />

    <!-- EfCore backend deps -->
    <PackageVersion Include="ZeroAlloc.ValueObjects.EfCore" Version="2.2.*" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.1*" />
    <PackageVersion Include="AdoNet.Async.Adapters" Version="1.5.2" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- CVE-2026-84008 / GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7: Microsoft.Data.SqlClient
         7.1.1, the latest release, pulls the vulnerable System.Security.Cryptography.Pkcs 9.0.18
         into the SQL Server test fixtures. Transitive pinning lifts it to a patched version; only
         net10.0 test projects reference SqlClient, so no shipped package changes. Drop once
         SqlClient depends on a patched Pkcs. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="ZeroAlloc.ORM" Version="2.3.4" />
    <PackageVersion Include="ZeroAlloc.ORM.Generator" Version="2.3.4" />
  </ItemGroup>

  <!-- EFCore 10 dropped net8.0 support, so we pin per-TFM:
       net8.0 consumers stay on EFCore 9; net10.0 gets EFCore 10. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.21" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>

    <!-- Outbox bridge deps -->
    <PackageVersion Include="ZeroAlloc.Outbox" Version="4.4.5" />
    <PackageVersion Include="ZeroAlloc.Outbox.EfCore" Version="4.4.5" />
    <PackageVersion Include="ZeroAlloc.Outbox.Orm" Version="4.4.5" />
    <PackageVersion Include="ZeroAlloc.Serialisation" Version="2.8.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />

    <!-- Resilience bridge deps -->
    <PackageVersion Include="ZeroAlloc.Resilience" Version="3.3.*" />

    <!-- Redis backend deps -->
    <PackageVersion Include="StackExchange.Redis" Version="3.4.*" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.*" />

    <!-- Generator deps -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.*" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.*" />

    <!-- Test deps -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!--
      Note: Microsoft.CodeAnalysis.CSharp.Analyzer.Testing and friends are not
      pinned here. PR 3 implements its own light-weight test harness on top of
      CSharpGeneratorDriver / AdhocWorkspace because the published Roslyn
      testing packages still pull in Microsoft.CodeAnalysis.* 3.8 and
      conflict with our 4.11 pin.
    -->

    <!-- Analyzer deps (transitive via Directory.Build.props) -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.30*" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.*" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.11.*" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
