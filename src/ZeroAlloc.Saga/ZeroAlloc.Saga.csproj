<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Saga</PackageId>
    <Description>Source-generated long-running process orchestration. Multi-step sagas with compensation, FSM via ZeroAlloc.StateMachine, dispatch via ZeroAlloc.Mediator. Native AOT compatible.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ZeroAlloc.Mediator 5.1.0 is the floor, not a preference: before it, generated
         Publish dispatched only to handlers discovered by concrete type in its own
         compilation, so it never reached the INotificationHandler<T> registrations
         With{Saga}Saga() emits and a saga never received its trigger event. See #127.
         The version itself is central, in Directory.Packages.props. -->
    <PackageReference Include="ZeroAlloc.Mediator" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Bundle the source generator into this nupkg as an analyzer asset. -->
  <!-- Mirrors ZeroAlloc.Resilience's IncludeGeneratorInPackage MSBuild target. -->

  <!--
    The generator ships inside THIS package while its source lives at
    src/ZeroAlloc.Saga.Generator. That used to be a release hazard: under the old
    per-package release-please components, the generator directory was not a declared
    package, so a generator-only commit mapped to nothing and never reached consumers.
    #95 and #71 both hit it; #131 hit the same hole via root Directory.Packages.props.

    Resolved in #98 by collapsing to a single root component, so every commit in the repo
    is attributed and the Release-As workaround this comment used to prescribe is gone.
    See docs/releasing.md.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Saga.Generator\ZeroAlloc.Saga.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\ZeroAlloc.Saga.Generator\bin\$(Configuration)\netstandard2.0\ZeroAlloc.Saga.Generator.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
